# MarketAI backend only. Never commit real secrets.
MARKETAI_SUPABASE_URL=https://your-project-ref.supabase.co
MARKETAI_SUPABASE_SECRET_KEY=replace-with-backend-only-secret-key
MARKETAI_ADMIN_API_KEY=replace-with-a-long-random-admin-token

# Separate, lower-privilege read-only key for the mobile app (GET /api/v1/events,
# /api/v1/events/{id}, /api/v1/events/{id}/paper-status). Must NOT be the same
# value as MARKETAI_ADMIN_API_KEY. Sent as the X-MarketAI-Key request header.
# If unset, these endpoints fail closed (503) instead of being open to anyone.
MARKETAI_READ_API_KEY=replace-with-a-separate-long-random-read-only-token

# Strong write-auth for POST /api/v1/events/{id}/strategy-draft/approve - the
# only endpoint that persists a new expectation version out of a
# draft-preview-approve flow. Must be its own value: never the read key
# (which must never authorize a write) and never the admin token (this key
# is intentionally narrower - it can only approve a previewed strategy
# draft, not perform arbitrary admin writes). This is the credential used
# both by the mobile app's own approval action and by any trusted external
# assistant integration calling the same provider-agnostic control API.
# Sent as the X-MarketAI-Control-Key request header. If unset, the approve
# endpoint fails closed (503). Still an MVP-tier shared secret, same caveat
# as MARKETAI_READ_API_KEY above: replace with real per-user/per-device auth
# before any public release.
MARKETAI_CONTROL_API_KEY=replace-with-a-third-separate-long-random-control-token

# Default AI path: Groq first, local Ollama fallback.
GROQ_API_KEY=replace-with-groq-key
MARKETAI_GROQ_MODEL=openai/gpt-oss-120b
MARKETAI_AI_RELEASE_CHAR_BUDGET=12000
MARKETAI_OLLAMA_ENABLED=true
MARKETAI_OLLAMA_URL=http://localhost:11434
MARKETAI_OLLAMA_MODEL=gpt-oss:20b

# Optional paid OpenAI fallback. Disabled unless explicitly enabled.
MARKETAI_ENABLE_OPENAI_FALLBACK=false
OPENAI_API_KEY=
MARKETAI_OPENAI_MODEL=gpt-5.6

# Earnings-calendar candidate/watchlist sync (trading_system/calendar_sync_worker.py).
# Backend-only - never exposed to the Expo app. Sync only ever writes
# candidate/tracked calendar rows; it can never affect the trading worker,
# the PAPER pipeline, or EventExpectationRepository.
FINNHUB_API_KEY=replace-with-a-finnhub-api-key
# Calendar range MVP: 30 days is both the default and the hard cap - the
# worker clamps any larger value, and GET /api/v1/calendar/upcoming
# (MAX_CALENDAR_LOOKAHEAD_DAYS in trading_system/api.py) rejects it outright.
MARKETAI_CALENDAR_LOOKAHEAD_DAYS=30

# SEC asks automated clients to identify themselves and provide contact info.
# Required by calendar_release_worker; use a real monitored contact address in
# production. The worker fails closed if this is absent or has no email address.
MARKETAI_SEC_USER_AGENT="MarketAI/0.1 your-contact@example.com"

# eToro backend-only market-data credentials. Used by EtoroMarketDataProvider
# for authenticated REST quotes and WebSocket subscriptions. Never expose
# either key through EXPO_PUBLIC_* variables or mobile source code.
ETORO_API_KEY=replace-with-etoro-api-key
ETORO_USER_KEY=replace-with-etoro-user-key

# Observation-only Trend monitoring. The current first model uses the canonical
# 15-minute EMA50/EMA200 contract. This controls only how often the worker
# refreshes the tracked-instrument/profile target snapshot; market updates remain
# live between refreshes. No Trend output is wired to trading by this setting.
MARKETAI_TREND_REFRESH_SECONDS=60

# Approved canonical PAPER execution. `internal` is the safe default in code.
# Set `etoro_demo` only when intentionally preparing Virtual Portfolio execution.
# The readiness workflow installs the worker unit but never enables or starts it.
MARKETAI_PAPER_BROKER=internal
MARKETAI_ETORO_DEMO_MAX_AMOUNT_USD=25
MARKETAI_PAPER_SPREAD_PCT=0.25
MARKETAI_APPROVED_PAPER_POLL_SECONDS=30
MARKETAI_APPROVED_PAPER_LEASE_SECONDS=120
MARKETAI_APPROVED_PAPER_BATCH_SIZE=50
MARKETAI_PAPER_PORTFOLIO_LEASE_SECONDS=900

# Internal PaperBroker baseline only. eToro demo execution builds equity, cash,
# positions, instrument exposure and current daily P&L from Virtual Portfolio.
MARKETAI_PAPER_EQUITY=10000
MARKETAI_PAPER_CASH=10000
MARKETAI_PAPER_OPEN_POSITIONS=0
MARKETAI_PAPER_INSTRUMENT_EXPOSURE_PCT=0
MARKETAI_PAPER_DAILY_PNL=0

MARKETAI_RELEASE_POLL_SECONDS=300

# Hours past the event expectation's scheduled_date before a continuing
# no_release state is flagged as overdue in logs/audit trail.
MARKETAI_RELEASE_OVERDUE_GRACE_HOURS=8

# Manual, explicit fallback only: if Hays Results Centre auto-discovery ever
# fails to match the real release (title/link format drift), set this to the
# exact official release URL (HTML or PDF) instead of guessing. Not a secret.
MARKETAI_HAYS_RELEASE_URL=