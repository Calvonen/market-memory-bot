# MarketAI backend only. Never commit real secrets.
MARKETAI_SUPABASE_URL=https://your-project-ref.supabase.co
MARKETAI_SUPABASE_SECRET_KEY=replace-with-backend-only-secret-key
MARKETAI_ADMIN_API_KEY=replace-with-a-long-random-admin-token

# Separate, lower-privilege read-only key for the mobile app (GET /api/v1/events,
# /api/v1/events/{id}, /api/v1/events/{id}/paper-status). Must NOT be the same
# value as MARKETAI_ADMIN_API_KEY. Sent as the X-MarketAI-Key request header.
# If unset, these endpoints fail closed (503) instead of being open to anyone.
MARKETAI_READ_API_KEY=replace-with-a-separate-long-random-read-only-token

# Default AI path: Groq first, local Ollama fallback.
GROQ_API_KEY=replace-with-groq-key
MARKETAI_GROQ_MODEL=openai/gpt-oss-120b
MARKETAI_AI_RELEASE_CHAR_BUDGET=12000
MARKETAI_OLLAMA_ENABLED=true
MARKETAI_OLLAMA_URL=http://localhost:11434
MARKETAI_OLLAMA_MODEL=gpt-oss:20b

# Optional paid OpenAI fallback. Disabled unless explicitly enabled.
MARKETAI_ENABLE_OPENAI_FALLBACK=false
OPENAI_API_KEY=
MARKETAI_OPENAI_MODEL=gpt-5.6

MARKETAI_RELEASE_POLL_SECONDS=300

# Hours past the event expectation's scheduled_date before a continuing
# no_release state is flagged as overdue in logs/audit trail.
MARKETAI_RELEASE_OVERDUE_GRACE_HOURS=8

# Manual, explicit fallback only: if Hays Results Centre auto-discovery ever
# fails to match the real release (title/link format drift), set this to the
# exact official release URL (HTML or PDF) instead of guessing. Not a secret.
MARKETAI_HAYS_RELEASE_URL=
