[Unit]
Description=MarketAI calendar US earnings release ingestion
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=marko
WorkingDirectory=/home/marko/marketai-repo
EnvironmentFile=/home/marko/marketai/.env
ExecStart=/home/marko/marketai-repo/.venv/bin/python -m trading_system.calendar_release_worker

# This worker only discovers official releases, stores source documents and AI
# analyses. It intentionally has no Strategy/Risk/Broker execution path.
