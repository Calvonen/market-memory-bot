Wants=network-online.target
After=network-online.target marketai-tracked-events.service

[Service]
Type=simple
WorkingDirectory=/home/marko/marketai-repo
EnvironmentFile=/home/marko/marketai-deploy-state/approved-paper-prepared.env
ExecStart=/home/marko/marketai-repo/.venv/bin/python -m trading_system.approved_paper_dispatch_worker
