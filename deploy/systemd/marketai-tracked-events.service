[Unit]
Description=MarketAI persistent tracked-event reaction worker
Documentation=file:///home/marko/marketai-repo/docs/tracked_event_runtime.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/marko/marketai-repo
EnvironmentFile=/home/marko/marketai/.env
ExecStart=/home/marko/marketai-repo/.venv/bin/python -m trading_system.tracked_event_worker
Restart=on-failure
RestartSec=5
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
